# =============================================================================
# Supabase
# =============================================================================
# Crear el proyecto en https://supabase.com → Settings → API Keys
# Supabase ahora usa "publishable" (browser) y "secret" (server) en vez de
# los legacy anon/service_role. Funcionan igual con el SDK; podés pegar
# cualquiera de los dos formatos en estas variables.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# SOLO para scripts del lado server (migraciones, N8N). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Proyecto Supabase de Cuadros Básicos / Floor Share (es un proyecto distinto al
# principal). Usado por /cuadros-basicos, /floor-share y el Objetivo 2 del Overview.
CB_SUPABASE_URL="https://YOUR_CB_PROJECT.supabase.co"
CB_SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# =============================================================================
# N8N (fase 2)
# =============================================================================
N8N_WEBHOOK_URL=""
N8N_API_KEY=""

# =============================================================================
# Apify (fase 2)
# =============================================================================
APIFY_API_TOKEN=""

# =============================================================================
# Google Sheets (data de scraping RRSS existente, fase 2)
# =============================================================================
GOOGLE_SHEETS_SOCIAL_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# =============================================================================
# BGT Mkt (Objetivo 1 del Overview)
# =============================================================================
# data.json de presupuesto/real sincronizado desde SharePoint. Lo consume el
# cron /api/cron/bgt-sync (que lo upsertea a la tabla bgt_marketing) y el
# Overview como fallback. Si se omite, usa el raw de GitHub por defecto.
BGT_DATA_JSON_URL="https://raw.githubusercontent.com/dsabena-byte/Dashboard-BGT/main/data.json"

# =============================================================================
# Google Ads / GA4 (pauta digital — costo por campaña + embudo de creativos)
# =============================================================================
# OAuth2 de la app "Dashboard Vercel" (Google Cloud → Google Auth Platform).
# El GOOGLE_REFRESH_TOKEN se genera en el OAuth Playground ("use your own OAuth
# credentials") con AMBOS scopes:
#   - https://www.googleapis.com/auth/analytics.readonly   (GA4)
#   - https://www.googleapis.com/auth/adwords               (Google Ads API)
# Si la app OAuth está en modo Testing, el refresh token expira ~7 días: publicar
# la app a producción para que no expire. Ver README (sección Google OAuth).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# Developer token de la Google Ads API. Se genera desde un manager account (MCC)
# en Herramientas → API Center. Requiere Basic Access aprobado por Google para
# consultar cuentas productivas (el Test Access sólo ve cuentas de test).
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Opcional: ID del MCC si las cuentas se consultan a través de un manager account
# (se envía en el header login-customer-id). Ej. MCC de OMD: 2013657015.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# =============================================================================
# Arcads (plataforma UGC "pro" — opción paralela al Seedance barato de fal)
# =============================================================================
# Credenciales de la API externa de Arcads (Settings → Public API → Generate
# credentials). Auth HTTP Basic. Se puede usar Client ID + Secret, o sólo la key.
ARCADS_CLIENT_ID=""
ARCADS_CLIENT_SECRET=""
# Alternativa: una sola API key (se usa como usuario Basic con password vacío).
ARCADS_API_KEY=""
# Opcional: fija el "product" contenedor (UUID) que /v2/videos/generate requiere;
# si no se setea, se crea uno automáticamente y se cachea en memoria del proceso.
ARCADS_PRODUCT_ID=""
# Opcional: override del base URL (default https://external-api.arcads.ai).
ARCADS_BASE_URL=""

# =============================================================================
# Crons (GitHub Actions → /api/cron/*)
# =============================================================================
# Secret compartido: cada ruta de cron exige Authorization: Bearer $CRON_SECRET.
# Vive en GitHub Actions secrets + Vercel env (no en el browser).
CRON_SECRET=""
# Tokens de pauta usados por los crons (viven sólo en secrets, no en el browser):
META_SYSTEM_USER_TOKEN=""
TIKTOK_ADVERTISER_ID=""

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
